+ * por el POST de arriba y, si lo tiene, consulta aqui antes de asumir nada.
+ */
+oltRoutes.get('/:id/onts/operations/:opId', requireRole(...STAFF_READ), async (c) => {
+  const opId = c.req.param('opId');
+  const deviceIdParam = c.req.param('id');
+  if (!opId || !deviceIdParam) return c.json({ error: 'Falta el id de la OLT o de la operacion' }, 400);
+  const result = await provisioningStore.findOperationById(opId, deviceIdParam);
+  if (result.error) return c.json({ error: result.error }, 500);
