+ * devuelve tal cual (no hay nada pendiente que reconciliar).
+ */
+oltRoutes.post('/:id/onts/operations/:opId/reconcile', requireRole(...ONT_PROVISION), async (c) => {
+  const device = await getDeviceOrNull(c.req.param('id'));
