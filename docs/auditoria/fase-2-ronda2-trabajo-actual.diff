+
+/**
+ * Construye el paso de MikroTik (crear o vincular un secreto PPPoE) a
+ * partir de `body.mikrotik`, si se pidio — nunca toca la OLT ni la base de
+ * datos de aprovisionamiento, solo RouterOS. Devuelve `undefined` cuando no
+ * se pidio (etapa "no aplica", no "pendiente" — ver isPipelineComplete en
+ * oltProvisioningService.ts).
+ */
+async function buildMikrotikSync(body: Record<string, unknown>): Promise<(() => Promise<void>) | undefined> {
+  const mikrotik = body.mikrotik as Record<string, unknown> | undefined;
+  if (!mikrotik?.deviceId) return undefined;
+
+  const device = await getMikrotikDeviceOrNull(String(mikrotik.deviceId));
+  if (!device) {
+    return async () => {
+      throw new Error('Router MikroTik no encontrado');
+    };
+  }
+  const target: MikrotikTarget = { host: device.host, port: device.port, useTls: device.use_tls, username: device.username, password: device.password };
+
+  return async () => {
+    if (mikrotik.secretMode === 'create') {
+      await mikrotikRequest(target, '/ppp/secret', {
+        method: 'POST',
+        body: {
+          name: String(mikrotik.newSecretName ?? ''),
+          password: String(mikrotik.newSecretPassword ?? ''),
+          profile: String(mikrotik.profile ?? ''),
+          service: 'pppoe',
+          comment: mikrotik.comment ? String(mikrotik.comment) : undefined,
+        },
+      });
+    } else {
+      await mikrotikRequest(target, `/ppp/secret/${String(mikrotik.existingSecretId ?? '')}`, {
+        method: 'PATCH',
+        body: { profile: String(mikrotik.profile ?? '') },
+      });
+    }
+  };
