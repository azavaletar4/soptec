+          operation: result.operation,
+          outcome: result.outcome,
+          ont: result.ont,
+          mikrotikOk: result.mikrotikOk,
+          mikrotikError: result.mikrotikError,
+          wanOk: result.wanOk,
+          wanError: result.wanError,
+          persistenceWarning: result.persistenceWarning,
+        },
+    result.httpStatus as any,
+  );
+});
+
+
