+// ---- Aprovisionamiento confiable (Fase 2) — ver oltProvisioningService.ts
+// y docs/auditoria/fase-2-aprovisionamiento.html ----
+
+async function getOperationOrNull(deviceId: string, idempotencyKey: string) {
+  const { data } = await supabaseAdmin
+    .from('olt_provisioning_operations')
+    .select('*')
+    .eq('olt_device_id', deviceId)
+    .eq('idempotency_key', idempotencyKey)
+    .maybeSingle();
+  return data;
+}
+
+/**
+ * Agrega una etapa al historial de la operacion (columna `steps`, jsonb).
+ * `detail` ya debe venir libre de credenciales — oltProvisioningService.ts
+ * nunca pasa el buffer crudo ni comandos completos aqui (ver redactSensitive/
+ * commandVerb en server/src/telnet/client.ts, Fase 1), solo mensajes ya
+ * sanitizados.
+ */
+async function appendProvisioningStep(opId: string, stage: string, status: string, detail?: string) {
+  const { data } = await supabaseAdmin.from('olt_provisioning_operations').select('steps').eq('id', opId).single();
+  const steps = Array.isArray(data?.steps) ? (data.steps as unknown[]) : [];
+  steps.push({ stage, status, at: new Date().toISOString(), detail: detail ?? null });
+  await supabaseAdmin.from('olt_provisioning_operations').update({ steps }).eq('id', opId);
+}
+
+function outcomeToOperationStatus(outcome: ProvisionOutcome): string {
+  switch (outcome.kind) {
+    case 'registered':
+    case 'already_registered':
+      return 'olt_registered';
+    case 'verify_mismatch':
+      return 'olt_verify_failed';
+    case 'uncertain':
+      return 'olt_uncertain';
+    default:
+      return 'failed';
+  }
+}
+
+/** Mensaje de error legible (sin credenciales) para dejar en la columna `error` de la operacion. */
+function outcomeErrorMessage(outcome: ProvisionOutcome): string | null {
+  switch (outcome.kind) {
+    case 'rejected':
+    case 'uncertain':
+    case 'invalid':
+      return outcome.message;
+    case 'capacity_full':
+      return 'No quedan onu-id libres en ese puerto (capacidad del puerto agotada)';
+    case 'conflict_elsewhere':
+      return `El serial ya esta registrado en gpon-onu_${outcome.at.shelf}/${outcome.at.slot}/${outcome.at.port}:${outcome.at.onuId} — no se toco nada`;
+    case 'conflict_same_position_different_config':
+      return `Ya existe una ONU distinta en esa misma posicion (onu-id ${outcome.onuId}) — no se sobreescribio`;
+    case 'verify_mismatch':
+      return `La OLT quedo con datos distintos a los solicitados: ${outcome.mismatches.map((m) => m.field).join(', ')}`;
+    default:
+      return null;
+  }
+}
+
+function provisionDepsFor(device: OltDeviceRow, opId: string): ProvisionDeps {
+  return {
+    withOltLock: (fn) => withOltLock(device.id, fn),
+    runTelnet: (commands, opts) => runTelnetCommands(telnetTargetFor(device), commands, opts),
+    onStage: (stage: ProvisionStage, status: ProvisionStageStatus, detail?: string) =>
+      appendProvisioningStep(opId, stage, status, detail),
+  };
+}
+
+/**
+ * Aprovisiona una ONT de forma IDEMPOTENTE y VERIFICADA (reemplaza, para
+ * quien lo use, la logica de POST /:id/onts de arriba):
+ *   - idempotencyKey identifica la SOLICITUD, no la fila: un doble-clic o un
+ *     reintento de red que reenvia la misma clave nunca repite el comando
+ *     de alta — ver provisionOnt()/findExistingBySerial() en
+ *     oltProvisioningService.ts, que siempre reescanea la OLT en vivo antes
+ *     de decidir si hace falta escribir algo.
+ *   - Solo escribe en olt_onts (y marca la operacion "completed") cuando la
+ *     OLT quedo escrita Y VERIFICADA — nunca antes.
+ *   - Un resultado incierto (timeout/cierre de conexion en la escritura) o
+ *     un conflicto (serial en otra posicion, o misma posicion con otra
+ *     config) NUNCA toca olt_onts ni borra/mueve nada — queda reportado para
+ *     que un humano decida o para reconciliar despues (ver endpoint de
