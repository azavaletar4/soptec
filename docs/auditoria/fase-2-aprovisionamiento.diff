+ */
+oltRoutes.post('/:id/onts/provision', requireRole(...ONT_PROVISION), async (c) => {
+  const device = await getDeviceOrNull(c.req.param('id'));
+  if (!device) return c.json({ error: 'OLT no encontrada' }, 404);
+
+  const body = await c.req.json();
+  const idempotencyKey = String(body.idempotencyKey ?? '').trim();
+  if (!idempotencyKey) return c.json({ error: 'idempotencyKey es requerido' }, 400);
+
+  const shelf = body.shelf ?? 1;
+  const { slot, port, serial, onuType, description, vlan, tcontProfile, trafficProfile, clientId, contractId } = body;
+  if (slot == null || port == null) return c.json({ error: 'slot y port son requeridos' }, 400);
+  if (!tcontProfile || !trafficProfile) {
+    return c.json({ error: 'tcontProfile y trafficProfile son requeridos (ver "show gpon profile tcont/traffic" en la OLT)' }, 400);
+  }
+
+  let operation = await getOperationOrNull(device.id, idempotencyKey);
+  if (operation?.status === 'completed') {
+    // Ya se hizo esta MISMA solicitud antes — ni se toca la OLT ni la BD de
+    // nuevo. Cubre el doble-clic y el reintento de red por igual.
+    return c.json({ operation, outcome: { kind: 'already_registered', onuId: operation.onu_id } });
+  }
+
+  if (!operation) {
+    const { data, error } = await supabaseAdmin
+      .from('olt_provisioning_operations')
+      .insert({
+        idempotency_key: idempotencyKey,
+        olt_device_id: device.id,
+        serial,
+        frame: shelf,
+        slot,
+        port,
+        client_id: clientId ?? null,
+        contract_id: contractId ?? null,
+        requested: { onuType, vlan, tcontProfile, trafficProfile, description: description ?? '', forcedOnuId: body.onuId ?? null },
+      })
+      .select()
+      .single();
+    if (error) return c.json({ error: error.message }, 400);
+    operation = data;
+  }
+
+  const ref: ZteInterfaceRef = { shelf, slot, port };
+  let outcome: ProvisionOutcome;
+  try {
+    outcome = await provisionOnt(provisionDepsFor(device, operation.id), {
+      ref,
+      serial,
+      onuType,
+      vlan,
+      description: description ?? '',
+      tcontProfile,
+      trafficProfile,
+      forcedOnuId: body.onuId ?? undefined,
+    });
+  } catch (e) {
+    const message = e instanceof Error ? e.message : 'Error inesperado al aprovisionar';
+    await supabaseAdmin.from('olt_provisioning_operations').update({ status: 'failed', error: message }).eq('id', operation.id);
+    return c.json({ error: message }, 502);
+  }
+
+  const patch: Record<string, unknown> = { status: outcomeToOperationStatus(outcome), error: outcomeErrorMessage(outcome) };
+  if ('onuId' in outcome) patch.onu_id = outcome.onuId;
+
+  let ontRow: Record<string, unknown> | null = null;
+  if (outcome.kind === 'registered' || outcome.kind === 'already_registered') {
+    const { data, error } = await supabaseAdmin
+      .from('olt_onts')
+      .upsert(
+        {
+          olt_device_id: device.id,
+          client_id: clientId ?? null,
+          contract_id: contractId ?? null,
+          frame: shelf,
+          slot,
+          port,
+          ont_id: outcome.onuId,
+          serial,
+          description,
+          onu_type: onuType,
+          vlan,
+          tcont_profile: tcontProfile,
+          traffic_profile: trafficProfile,
+          status: 'unknown',
+          last_synced_at: new Date().toISOString(),
+        },
+        { onConflict: 'olt_device_id,frame,slot,port,ont_id' },
+      )
+      .select()
+      .single();
+    if (error) {
+      patch.status = 'failed';
+      patch.error = `La OLT quedo bien, pero no se pudo guardar en la base de datos: ${error.message}`;
+    } else {
+      ontRow = data;
+      patch.status = 'completed';
+      patch.ont_db_id = data.id;
+      oltEvents.emitOntChanged({ oltDeviceId: device.id, ont: data });
+    }
+  }
+
+  await supabaseAdmin.from('olt_provisioning_operations').update(patch).eq('id', operation.id);
+  return c.json({ operation: { ...operation, ...patch }, outcome, ont: ontRow });
+});
+
+/** Progreso/resultado de una operacion de aprovisionamiento — para que el frontend muestre que se completo y que falta (requisito 6, Fase 2). */
+oltRoutes.get('/:id/onts/operations/:opId', requireRole(...STAFF_READ), async (c) => {
