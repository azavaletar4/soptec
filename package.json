{
  "name": "smartrayco",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SmartRayco - Sistema de gestion ISP (Vue 3 + Vite + Tailwind CSS 4 + Hono + Supabase)",
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c blue,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start:api": "tsx server/src/index.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.1",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "hono": "^4.6.3",
    "pinia": "^2.2.4",
    "vue": "^3.5.10",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "concurrently": "^9.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vue-tsc": "^2.1.6"
  }
}
