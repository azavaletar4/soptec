# =============================================
# SUPABASE - Settings > API en app.supabase.com
# =============================================

# URL publica del proyecto
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Clave anonima (publica, segura para el frontend)
VITE_SUPABASE_ANON_KEY=

# Clave de servicio (PRIVADA - solo backend, nunca al frontend). Se usa desde la Fase 2.
SUPABASE_SERVICE_ROLE_KEY=

# =============================================
# BACKEND (Hono - Node.js) - desde la Fase 2
# =============================================

PORT=3000
NODE_ENV=development

# Nota: no hace falta JWT_SECRET. El backend verifica los tokens de Supabase
# contra las llaves publicas del proyecto (/auth/v1/.well-known/jwks.json),
# construidas a partir de VITE_SUPABASE_URL de arriba.

# =============================================
# CLOUDFLARE TUNNEL (opcional, produccion)
# =============================================

VITE_API_URL=http://localhost:3000

# =============================================
# TR-069 / GenieACS (Fase 6d-g) - opcional
# =============================================
# Imagen usada: drumsergio/genieacs (ver docker-compose.yml) — el nombre
# "genieacs/genieacs" que sugeria REPLICA-TR069-GENIEACS.md no existe en
# Docker Hub.

# URL del NBI (API interna) de GenieACS, que usa el backend para
# consultar/gestionar CPEs. En Docker on-prem: http://genieacs:7557
# En desarrollo local (docker-compose.yml): http://localhost:7557
GENIEACS_NBI=http://localhost:7557

# Solo lo usa docker-compose.onprem.yml (firma las sesiones del panel web
# de GenieACS, puerto 3001). Genera un valor random, ej: openssl rand -hex 32
GENIEACS_UI_JWT_SECRET=

# Scheduler automatico (server/src/services/tr069Scheduler.ts): sincroniza
# dispositivos y recolecta metricas TR-069 solo, sin depender del boton
# manual del panel. TR069_SCHEDULER_ENABLED=false lo desactiva (util en un
# dev sin GenieACS levantado, para no llenar la consola de errores).
TR069_SCHEDULER_ENABLED=true
TR069_SYNC_INTERVAL_MINUTES=15
TR069_METRICS_INTERVAL_MINUTES=10

# =============================================
# XUI.one (panel IPTV) - integracion opcional
# =============================================
# No tiene API REST propia: el backend scrapea el panel admin (login por
# cookie + AJAX del propio HTML). Ver server/src/services/xuiService.ts.

# Ruta base del panel, incluyendo el subdirectorio del reseller (ej: /RaycoAlex)
XUI_BASE_URL=http://172.168.1.253/RaycoAlex
XUI_USERNAME=
XUI_PASSWORD=

# =============================================
# Reconciliacion MikroTik -> Panel (Fase 31) - opcional
# =============================================
# Router/usuario/clave de cada MikroTik se guardan en la tabla
# mikrotik_devices (se administran desde /mikrotik), no aqui. Esto solo
# controla el scheduler que compara /ppp/secret contra la BD.
MIKROTIK_RECONCILE_SCHEDULER_ENABLED=true
MIKROTIK_RECONCILE_INTERVAL_MINUTES=30

# =============================================
# Alertas entrantes (LibreNMS -> WhatsApp) (Fase 31) - opcional
# =============================================
# LibreNMS (u otro sistema) hace POST a /api/alerts/librenms con este
# secreto como header "X-Alert-Secret" o ?secret=. El envio real a WhatsApp
# esta pendiente de elegir gateway (ver server/src/routes/alerts.ts) — por
# ahora las alertas que llegan solo se loguean.
ALERTS_WEBHOOK_SECRET=

# =============================================
# Corte por deuda (Fase 25) - opcional
# =============================================
# Scheduler automatico (server/src/services/debtHoldScheduler.ts): marca
# (NO aplica) los contratos activos con una factura vencida hace >=
# DEBT_HOLD_GRACE_DAYS dias. El corte real (OLT + MikroTik) siempre lo
# confirma una persona desde /cortes. DEBT_HOLD_SCHEDULER_ENABLED=false lo
# desactiva.
DEBT_HOLD_SCHEDULER_ENABLED=true
DEBT_HOLD_GRACE_DAYS=7
DEBT_HOLD_SCAN_INTERVAL_MINUTES=360

# =============================================
# Auditoria SmartOLT (server/scripts/audit-smartolt.ts) - opcional
# =============================================
# Solo para el script manual de auditoria de solo lectura (npm run
# audit:smartolt) que compara los ONUs de la cuenta SmartOLT de antes de
# usar SmartRayco contra olt_onts. SMARTOLT_SUBDOMAIN es la parte antes de
# ".smartolt.com" en tu URL; el token esta en SmartOLT > Configuracion >
# API Access. Si no vas a correr ese script, dejalos vacios.
SMARTOLT_SUBDOMAIN=
SMARTOLT_API_TOKEN=
