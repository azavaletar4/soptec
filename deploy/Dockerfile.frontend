# SmartRayco frontend: build Vite + nginx. ARM64/AMD64.
# Usa `npx vite build` (no `npm run build`) — vue-tsc puede tener errores de
# tipo que no deberian bloquear el build de produccion (correlos aparte en CI
# si se quiere ese gate).
FROM node:20-slim AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG SOURCE_COMMIT
ENV SOURCE_COMMIT=$SOURCE_COMMIT
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Fecha/hora ISO (UTC) de activacion de la deteccion de consumo de material
# sin custodia (ver src/lib/materialCustodyShortfall.ts) — opcional, vacio
# por defecto (= "todavia no activada", todo hallazgo queda como historico).
# Se fija una sola vez, el dia que se decida activar el aviso en vivo.
ARG VITE_MATERIAL_CUSTODY_LIVE_SINCE=""
ENV VITE_MATERIAL_CUSTODY_LIVE_SINCE=$VITE_MATERIAL_CUSTODY_LIVE_SINCE

# release-source.json se exporta desde un commit limpio con build:release.
# Dentro de Docker no se usa .git ni se aceptan fuentes sin comprobar.
RUN node scripts/frontend-release-build.mjs --snapshot release-source.json

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
