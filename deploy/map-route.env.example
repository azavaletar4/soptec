# Política actual: costo S/0. OSM + EOxCloudless 2016 + overlay EOX.
# No requiere variables, cuenta, tarjeta, API key ni facturación.
# El Mapa de Red IGNORA las variables históricas siguientes.
# Los adaptadores anteriores se conservan en código como referencia inactiva.
# Variables PUBLICAS del frontend; completar solo en el entorno local autorizado.
# No introducir una clave de servicio/backend. Restringir el origen de la clave.
VITE_MAPTILER_KEY=
# Habilitar únicamente con cuenta/plan que permita este uso comercial.
VITE_MAPTILER_LICENSED=false

# Valor histórico; no selecciona proveedores bajo la política S/0 actual.
VITE_NETWORK_MAP_PROVIDER=existing
# Prototipo validado SOLO con credenciales ficticias. No usar claves privadas
# de servidor en VITE. Map Tiles requiere validar restricciones IP/proxy
# autenticado antes de habilitarlo para operadores remotos.
VITE_GOOGLE_MAPS_KEY=
# NO habilitar hasta autorizar facturación, clave restringida y uso/licencia.
VITE_GOOGLE_MAPS_AUTHORIZED=false
